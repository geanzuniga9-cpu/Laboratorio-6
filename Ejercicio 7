using UnityEngine;

public class Comprarextremos : MonoBehaviour
{
    int[] daño = new int[4];

    private void Start()
    {
        daño[0] = 10;
        daño[1] = 20;
        daño[2] = 30;
        daño[3] = 40;

        if (daño[0] == daño[daño.Length - 1])
        {
            print("El primer valor y ultimo valor SON iguales");
        }
        else
        {
            print("El primer valor y ultimo valor No son iguales");
        }
    }
}
